# CockroachDB Cloud connection string, from the Cloud Console
# (Basic/Serverless tier). Include ?sslmode=verify-full.
COCKROACHDB_URL=postgresql://<user>:<password>@<host>:26257/<database>?sslmode=verify-full

# Groq API key, from console.groq.com
GROQ_API_KEY=

# Required by SEC EDGAR on every request. Format: "Name email@example.com"
# Requests without a proper User-Agent are rate-limited or blocked.
SEC_EDGAR_USER_AGENT="Your Name your.email@example.com"

# Local embedding model — default is fine, override only if needed
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Not needed until Phase 3, leave blank for now ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_ARCHIVE_BUCKET=
COCKROACHDB_MCP_ENDPOINT=https://cockroachlabs.cloud/mcp
